[user]
	name = Scott Peterson

[color]
    ui     = true
    branch = auto
    diff   = auto
    status = auto

[color "branch"]
    current = red bold
    local   = green bold
    remote  = blue bold
    upstream = blue bold

[color "diff"]
    meta       = yellow bold
    frag       = magenta bold
    old        = red bold
    new        = green bold
    whitespace = red reverse

[color "status"]
    added     = yellow
    changed   = green
    untracked = cyan

[core]
    autocrlf    = false
    editor = vim
	excludesfile = /Users/scottpeterson/.gitignore_global
    whitespace  = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[diff]
    # git diff will use (i)ndex, (w)ork tree, (c)ommit and (o)bject
    # instead of a/b/c/d as prefixes for patches
    mnemonicprefix = true
    compactionHeuristic = true
    submodule = log

[log]
    decorate = full

[stash]
    showpatch = true

[rebase]
    autostash = true

[branch]
    autosetuprebase = always

[merge]
    summary   = true
    verbosity = 1
    ff        = false
	conflictStyle = diff3

[apply]
    whitespace = nowarn

[incude]
    path = ~/.local_gitconfig

[pull]
    rebase = true
    ff = only

[push]
    default = simple

[fetch]
    prune = true

[alias]
    # restore file modes that changed without content changes
    permission-reset = !git diff -p -R | grep -E \"^(diff|(old|new) mode)\" | git apply

    # difftastic, on request only (plain `git diff` stays a patch)
    ddiff = -c diff.external=difft diff
    dlog  = -c diff.external=difft log -p --ext-diff
    dshow = -c diff.external=difft show --ext-diff

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[rerere]
	enabled = true
	autoUpdate = true
[merge "mergiraf"]
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
	name = mergiraf
[include]
	path = ~/.gitconfig.local
